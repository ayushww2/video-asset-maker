generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                      String     @id @default(uuid()) @db.Uuid
  title                   String
  script                  String?
  guidance                String?
  niche                   String?
  mood                    String?
  realFootage             String?    @map("real_footage")
  assetCount              Int        @default(22) @map("asset_count")
  referenceNotes          String?    @map("reference_notes")
  referenceImages         Json       @default("[]") @map("reference_images")
  ownerUsername           String?    @map("owner_username")
  status                  String     @default("queued")
  plan                    Json?
  estimate                Json?
  actualReasoningCostUsd  Decimal?   @map("actual_reasoning_cost_usd") @db.Decimal(10, 4)
  actualImageCostUsd      Decimal?   @map("actual_image_cost_usd") @db.Decimal(10, 4)
  actualTotalCostUsd      Decimal?   @map("actual_total_cost_usd") @db.Decimal(10, 4)
  actualReasoningMs       Int?       @map("actual_reasoning_ms")
  actualImageMs           Int?       @map("actual_image_ms")
  actualReasoningTokens   Int?       @map("actual_reasoning_tokens")
  progressDone            Int        @default(0) @map("progress_done")
  progressTotal           Int        @default(0) @map("progress_total")
  error                   String?
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt             DateTime?  @map("completed_at") @db.Timestamptz(6)
  assets                  JobAsset[]

  @@index([createdAt(sort: Desc)], map: "jobs_created_at_idx")
  @@index([ownerUsername], map: "jobs_owner_username_idx")
  @@map("jobs")
}

model JobAsset {
  id            String    @id @default(uuid()) @db.Uuid
  jobId         String    @map("job_id") @db.Uuid
  assetNumber   Int       @map("asset_number")
  selected      Boolean   @default(true)
  status        String    @default("pending")
  payload       Json      @default("{}")
  imageBase64   String?   @map("image_base64")
  imageMimeType String?   @map("image_mime_type")
  imageUrl      String?   @map("image_url")
  imageR2Key    String?   @map("image_r2_key")
  costUsd       Decimal?  @map("cost_usd") @db.Decimal(10, 4)
  error         String?
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, assetNumber], map: "job_assets_job_id_asset_number_key")
  @@index([jobId], map: "job_assets_job_id_idx")
  @@map("job_assets")
}
